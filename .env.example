# =========================================================================
# VIDORA SaaS Environment Configuration
# =========================================================================

# 1. Supabase Database & Auth (Dapatkan dari Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Cloudflare R2 Object Storage (Dapatkan dari Cloudflare Dashboard > R2 > Manage R2 API Tokens)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=vidora-videos
R2_PUBLIC_DOMAIN=https://pub-your-id.r2.dev

# 3. Worker Configuration
WORKER_MAX_CONCURRENT=4
WORKER_HEADLESS=true
